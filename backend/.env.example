# ── Database (RDS Postgres) ───────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gyftr
DB_USER=gyftr_admin
DB_PASSWORD=your_db_password

# ── AWS Cognito ───────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_REGION=us-east-1

# ── Optional: use Secrets Manager instead of DB_* vars above ─────────────────
# If set, DB credentials are pulled from Secrets Manager and DB_* vars above are ignored.
# AWS_SECRET_NAME=gyftr/db-credentials
# AWS_REGION=us-east-1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net
