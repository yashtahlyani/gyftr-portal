# ── AWS region (used by Secrets Manager and Cognito) ─────────────────────────
AWS_REGION=ap-south-1

# ── Database (RDS Postgres) ──────────────────────────────────────────────────
# Preferred: leave these blank and set AWS_SECRET_NAME below, so no database
# password is ever written to disk on the EC2 box.
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gyftr
DB_USER=gyftr_admin
DB_PASSWORD=

# If set, DB credentials are pulled from AWS Secrets Manager and the DB_* vars
# above are ignored. This is the recommended production setup.
# AWS_SECRET_NAME=gyftr/portal/db

# ── AWS Cognito ──────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_REGION=ap-south-1

# Domains a user may sign in from. A person is identified by the part before
# the @, so name@gyftr.net and name@gyftr.com are treated as the same user.
COMPANY_EMAIL_DOMAINS=gyftr.net,gyftr.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=7878
# Exact origin of the deployed frontend — used for CORS. Do not leave as *.
FRONTEND_URL=https://portal.gyftr.net
