# ── Database (RDS Postgres) ───────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gyftr
DB_USER=gyftr_admin
DB_PASSWORD=your_db_password

# ── AWS Cognito ───────────────────────────────────────────────────────────────
# Leave empty / omit until Cognito is created, and set AUTH_DISABLED=true below.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1

# Temporary: allow API to run without Cognito (set to false once Cognito exists)
AUTH_DISABLED=true

# Temporary: allow API to start without Postgres (set to false once RDS exists)
DB_DISABLED=true

# ── Optional: use Secrets Manager instead of DB_* vars above ─────────────────
# If set, DB credentials are pulled from Secrets Manager and DB_* vars above are ignored.
# AWS_SECRET_NAME=gyftr/db-credentials
# AWS_REGION=us-east-1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=7878
FRONTEND_URL=https://portal.gyftr.net
