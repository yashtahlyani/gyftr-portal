# Frontend environment variables (copy to .env and fill in).
# These are embedded into the built JS bundle, so only put PUBLIC values here.
# There are no database credentials: the browser only ever talks to the API.

# URL of the Express backend API
VITE_API_URL=https://backend-portal.gyftr.net

# AWS Cognito — from the Cognito User Pool console
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
