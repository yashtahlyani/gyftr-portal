# Environment for docker-compose / deployments (copy to .env and fill in)

# ── URLs ────────────────────────────────────────────────────────────────────
# Frontend: https://portal.gyftr.net
# Backend:  https://backend-portal.gyftr.net

VITE_API_URL=https://backend-portal.gyftr.net
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

PORT=7878
FRONTEND_URL=https://portal.gyftr.net
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=ap-south-1

# Database (or use AWS_SECRET_NAME instead)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=gyftr
DB_USER=gyftr_admin
DB_PASSWORD=your_db_password

# Optional: Secrets Manager (overrides DB_* when set)
# AWS_SECRET_NAME=gyftr/portal/db
# AWS_REGION=ap-south-1
