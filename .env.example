# Root .env — used by docker-compose only (see docker-compose.yml).
# Copy to .env and fill in. Never commit the filled-in file.
#
# Deploying to AWS instead of Docker? These are not the files you want:
#   frontend/.env.example   VITE_* values, baked into the bundle at build time
#   backend/.env.example    runtime config for the API on EC2/ECS

# Cognito — required even locally; there is no local substitute for it.
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=ap-south-1

# Local Postgres (the db service in docker-compose). Not the RDS credentials.
DB_NAME=gyftr
DB_USER=gyftr_admin
DB_PASSWORD=localdev

# Email domains a user may sign in from — a person is identified by the part
# before the @, so name@gyftr.net and name@gyftr.com are the same user.
COMPANY_EMAIL_DOMAINS=gyftr.net,gyftr.com
